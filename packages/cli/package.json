{
  "name": "orizu",
  "version": "0.0.4",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./instruction-set-loader": { "types": "./dist/instruction-set-loader.d.ts", "default": "./dist/instruction-set-loader.js" }
  },
  "bin": {
    "orizu": "dist/index.js"
  },
  "files": [
    "README.md",
    "dist",
    "requirements",
    "scripts",
    "src",
    "tsconfig.json",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node scripts/build-cli-dist.mjs && node scripts/vendor-gepa-python.mjs && node scripts/vendor-orizu-skill.mjs",
    "postpack": "node scripts/vendor-gepa-python.mjs --clean && node scripts/vendor-orizu-skill.mjs --clean"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@vercel/sandbox": "1.10.2",
    "esbuild": "^0.25.8"
  },
  "devDependencies": {
    "@daytonaio/sdk": "0.193.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^24.0.0",
    "postcss": "^8.5.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.1.10",
    "typescript": "5.8.3"
  }
}
